{
  "name": "strapi-plugin-cookie-consent",
  "version": "1.0.3",
  "description": "GDPR cookie consent logging for Strapi v5 — Google Consent Mode V2, CNIL-compliant, IP anonymization, auto-configured public POST endpoint",
